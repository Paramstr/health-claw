# WHOOP API credentials — get from https://developer.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Scopes to request
WHOOP_SCOPES=read:recovery read:cycles read:sleep read:workout read:profile read:body_measurement offline

# Postgres (matches docker-compose defaults)
POSTGRES_PASSWORD=whoop_dev
DATABASE_URL=postgresql+asyncpg://whoop:whoop_dev@localhost:5432/whoop

# Fernet key for encrypting tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET=
